# PRONO SPORT 2.0 — configuration (TOUT est gratuit ; aucune variable n'est obligatoire)

# Base de données : SQLite par défaut (gratuit, zéro installation).
# PostgreSQL possible sur ta machine : postgresql+psycopg://user:pass@localhost:5432/prono_sport
DATABASE_URL=sqlite:////chemin/vers/prono-sport/data/prono_sport.db

# 6e source (optionnelle, GRATUITE — créer la clé sur https://www.football-data.org, 10 req/min)
FOOTBALL_DATA_ORG_TOKEN=

# Rafraîchissements automatiques quand l'API tourne
AUTO_INGEST=1            # boucle ESPN hier/aujourd'hui/demain
AUTO_INGEST_SECONDS=300  # toutes les 5 min
AUTO_LIVE=1              # boucle rapide quand des matchs sont EN DIRECT
AUTO_LIVE_SECONDS=75

# Port serveur
# (lancé via : uvicorn app.api:app --host 0.0.0.0 --port 8000)
