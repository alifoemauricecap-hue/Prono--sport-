# PRONO SPORT 3.0 — configuration
# TOUT est GRATUIT (0 €) : aucune variable n'est obligatoire.
# Les clés ci-dessous sont OPTIONNELLES (toutes gratuites, jamais de service payant).

# Base de données : SQLite par défaut (0 €, zéro installation).
# PostgreSQL possible : postgresql+psycopg://user:pass@localhost:5432/prono_sport
DATABASE_URL=sqlite:////chemin/vers/prono-sport/data/prono_sport.db

# === SOURCES OPTIONNELLES (gratuites, jamais obligatoires) ===
# football-data.org — clé gratuite (https://www.football-data.org) : 12 compétitions, 10 req/min
FOOTBALL_DATA_ORG_TOKEN=
# API-Football — clé gratuite (https://www.api-football.com) : ~100 req/jour, lineups
API_FOOTBALL_KEY=
# The Odds API — clé gratuite (https://the-odds-api.com) : 500 crédits/mois
ODDS_API_KEY=
# TheSportsDB — clé free publique (défaut "3")
TSDB_KEY=3

# === RAFFRAÎCHISSEMENTS AUTOMATIQUES (workers journalisés) ===
AUTO_INGEST=1            # worker syncFixtures (ESPN + cotes fduk)
AUTO_INGEST_SECONDS=300  # toutes les 5 min
AUTO_LIVE=1              # worker syncLiveMatches quand des matchs sont EN DIRECT
AUTO_LIVE_SECONDS=75     # toutes les 75 s
AUTO_COMPUTE=1           # recalcul analytics + prédictions + value bets
AUTO_COMPUTE_SECONDS=3600
AUTO_DISCOVER=1          # worker discoverSources (contrôle des sources)
DISCOVER_SECONDS=604800  # hebdomadaire (7 j)

# === ADMIN (optionnel) ===
# Si défini, POST /v1/admin/sync/* exige l'en-tête x-admin-token
ADMIN_TOKEN=

# Port serveur (lancé via : uvicorn app.api:app --host 0.0.0.0 --port 8000)
